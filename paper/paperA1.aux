\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces $G(N)$ and the evidence on $g_N$. ``Box $B$'': an exhaustive search over primitive $N$-sets (gcd of the entries $1$) with entries $\le B$ found no set with value in $(1/(N+1),G(N))$ (for $N=6$ the set above is found). ``Computed'' is a statement inside the box only: a lower bound over a finite basis, not a landscape. $G(N)<2/(2N+1)$ for exactly the $N\equiv 1\pmod  6$ with $7\le N\le 127$ among $N\le 130$ (computed).}}{21}{table.4}\protected@file@percent }
\newlabel{tab:gN}{{4}{21}{$G(N)$ and the evidence on $g_N$. ``Box $B$'': an exhaustive search over primitive $N$-sets (gcd of the entries $1$) with entries $\le B$ found no set with value in $(1/(N+1),G(N))$ (for $N=6$ the set above is found). ``Computed'' is a statement inside the box only: a lower bound over a finite basis, not a landscape. $G(N)<2/(2N+1)$ for exactly the $N\equiv 1\pmod 6$ with $7\le N\le 127$ among $N\le 130$ (computed)}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Box searches (computed). In every row the least non-tight value equals $G(N)$. For $N=13$ the tight sets are $[13]$ and $(1,\dots  ,11,13,24)$. The sets at $2/(2N+1)$ are not all one-entry dilations: for $N=9$ the sets $(1,2,3,5,7,8,11,13,18)$ and $(2,5,6,8,9,11,13,14,17)$ also have value $2/19$, so only the value, not the extremal set, is conjectured to match the family.}}{22}{table.5}\protected@file@percent }
\newlabel{tab:box}{{5}{22}{Box searches (computed). In every row the least non-tight value equals $G(N)$. For $N=13$ the tight sets are $[13]$ and $(1,\dots ,11,13,24)$. The sets at $2/(2N+1)$ are not all one-entry dilations: for $N=9$ the sets $(1,2,3,5,7,8,11,13,18)$ and $(2,5,6,8,9,11,13,14,17)$ also have value $2/19$, so only the value, not the extremal set, is conjectured to match the family}{table.5}{}}
\newlabel{q:class}{{7.1}{22}{}{theorem.7.1}{}}
